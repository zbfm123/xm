# ===================================================================
# 本地凭据模板
#
# 用法：复制本文件为 application-local.yml（同目录），填入你自己的值。
#       application-local.yml 已被 .gitignore 排除，不会进仓库。
#
# 或者不用本文件，直接设环境变量即可（run-dev.ps1 会自动设置）。
# ===================================================================
spring:
  datasource:
    username: root
    password: "在这里填你的 MySQL 密码"
  data:
    redis:
      password: "在这里填你的 Redis 密码，没有就留空"
